# Ara OS 12+ v3 — Transformers Neural Configuration
# Default runs real Hugging Face Transformers directly in-browser via WebGPU/WASM (no API key needed!)
ARA_DEFAULT_PROVIDER=transformers-web

# Optional Python PyTorch Transformers Server (see backend-python/server.py)
TRANSFORMERS_PYTHON_URL=http://localhost:8000

# Optional Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional OpenAI-compatible API (OpenAI, OpenRouter, Groq, DeepSeek, LM Studio)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Anthropic Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
